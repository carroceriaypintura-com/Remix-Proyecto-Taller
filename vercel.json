{
  "rewrites": [
    { "source": "/administracion", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/administracion",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
